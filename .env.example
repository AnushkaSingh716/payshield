# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to GitHub.

# --- Database (PostgreSQL) ---
POSTGRES_USER=payshield
POSTGRES_PASSWORD=change_me
POSTGRES_DB=payshield
# Port on YOUR computer used to reach the Docker database.
# If Windows says "ports are not available" for 5432, use 5433 here
# AND in DATABASE_URL below.
DB_PORT=5432
DATABASE_URL=postgresql://payshield:change_me@localhost:5432/payshield

# --- Backend ---
# Websites allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173
FRAUD_MODEL_PATH=ml/artifacts/model.pkl
SCAM_MODEL_PATH=ml/artifacts/scam_model.pkl

# --- MLflow ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db